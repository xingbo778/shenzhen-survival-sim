{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shenzhen-shared/schemas/bot-state.schema.json",
  "title": "BotState",
  "description": "深圳生存模拟 - Bot状态结构（world engine ↔ pixel city 共享）",
  "type": "object",
  "required": ["id", "name", "age", "gender", "location", "hp", "money", "energy", "satiety", "status", "emotions"],
  "properties": {
    "id":       { "type": "string", "pattern": "^bot_\\d+$" },
    "name":     { "type": "string" },
    "age":      { "type": "number", "minimum": 0 },
    "gender":   { "type": "string", "enum": ["男", "女"] },
    "origin":   { "type": "string" },
    "edu":      { "type": "string" },
    "home":     { "type": "string" },
    "location": { "type": "string" },
    "hp":       { "type": "number", "minimum": 0, "maximum": 100 },
    "money":    { "type": "number", "minimum": 0 },
    "energy":   { "type": "number", "minimum": 0, "maximum": 100 },
    "satiety":  { "type": "number", "minimum": 0, "maximum": 100 },
    "status":   { "type": "string", "enum": ["alive", "dead"] },
    "job":      { "type": ["string", "null"] },
    "is_sleeping": { "type": "boolean" },
    "skills": {
      "type": "object",
      "properties": {
        "tech":     { "type": "number", "minimum": 0, "maximum": 100 },
        "social":   { "type": "number", "minimum": 0, "maximum": 100 },
        "creative": { "type": "number", "minimum": 0, "maximum": 100 },
        "physical": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "emotions": {
      "type": "object",
      "required": ["happiness", "sadness", "anger", "anxiety", "loneliness"],
      "properties": {
        "happiness":  { "type": "number", "minimum": 0, "maximum": 100 },
        "sadness":    { "type": "number", "minimum": 0, "maximum": 100 },
        "anger":      { "type": "number", "minimum": 0, "maximum": 100 },
        "anxiety":    { "type": "number", "minimum": 0, "maximum": 100 },
        "loneliness": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "desires": {
      "type": "object",
      "properties": {
        "lust":     { "type": "number", "minimum": 0, "maximum": 100 },
        "power":    { "type": "number", "minimum": 0, "maximum": 100 },
        "greed":    { "type": "number", "minimum": 0, "maximum": 100 },
        "vanity":   { "type": "number", "minimum": 0, "maximum": 100 },
        "security": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "long_term_goal":    { "type": ["string", "null"] },
    "current_activity":  { "type": "string" },
    "narrative_summary": { "type": ["string", "null"] },
    "reputation": {
      "type": "object",
      "properties": {
        "score": { "type": "number", "minimum": -100, "maximum": 100 },
        "tags":  { "type": "array", "items": { "type": "string" } },
        "deeds": { "type": "array" }
      }
    },
    "generation":     { "type": "integer", "minimum": 0 },
    "inherited_from": { "type": ["string", "null"] },
    "phone_battery":  { "type": "number", "minimum": 0, "maximum": 100 },
    "aging_rate":     { "type": "number", "minimum": 0 },
    "action_log":     { "type": "array" },
    "core_memories":  { "type": "array" }
  }
}
